<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             x:Class="Luma.App.Controls.WallpaperGrid"
             x:Name="Root"
             x:DataType="c:WallpaperGrid">

  <UserControl.DataTemplates>

    <DataTemplate DataType="c:HeaderRow">
      <ContentPresenter Content="{Binding Content}" />
    </DataTemplate>

    <DataTemplate DataType="c:WallpaperRow">
      <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{Binding $parent[c:WallpaperGrid].Gap}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:WallpaperItemViewModel">
            <c:WallpaperCard Width="{Binding $parent[c:WallpaperGrid].CardWidth}"
                             Height="{Binding $parent[c:WallpaperGrid].CardHeight}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="c:SkeletonRow">
      <ItemsControl ItemsSource="{Binding Slots}" Margin="0,0,0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{Binding $parent[c:WallpaperGrid].Gap}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:Int32">
            <Border Classes="skeleton" CornerRadius="14"
                    Width="{Binding $parent[c:WallpaperGrid].CardWidth}"
                    Height="{Binding $parent[c:WallpaperGrid].CardHeight}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="c:FooterRow">
      <Panel MinHeight="64">
        <Button Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"
                Command="{Binding $parent[c:WallpaperGrid].LoadMoreCommand}"
                IsVisible="{Binding $parent[c:WallpaperGrid].ShowLoadMoreButton}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="16" />
            <TextBlock Text="Load more" />
          </StackPanel>
        </Button>
        <TextBlock Text="You've reached the end" Classes="meta" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding $parent[c:WallpaperGrid].ShowEndNote}" />
        <TextBlock Text="Loading more…" Classes="meta" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding $parent[c:WallpaperGrid].IsLoadingMore}" />
      </Panel>
    </DataTemplate>

  </UserControl.DataTemplates>

  <ListBox x:Name="List" Classes="plain"
           ItemsSource="{Binding #Root.Rows}"
           Padding="{Binding #Root.GridPadding}" />
</UserControl>
