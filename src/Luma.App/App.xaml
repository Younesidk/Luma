<Application
    x:Class="Luma.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Luma design system. Order matters: later dictionaries win, so Tokens overrides Fluent's brushes. -->
        <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Theme/accent tokens live in Styles/Tokens.xaml; ThemeService mutates its accent brushes in place. -->
    </ResourceDictionary>
  </Application.Resources>
</Application>
