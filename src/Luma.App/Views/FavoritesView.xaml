<UserControl
    x:Class="Luma.App.Views.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: FavoritesViewModel (set by MainWindow.CreatePageView). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="32,4,32,0" Spacing="4">
      <TextBlock Text="Favorites" Style="{StaticResource DisplayTextStyle}" />
      <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="32,22,32,16" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="190" />
      </Grid.ColumnDefinitions>
      <Border Height="44" CornerRadius="13" Background="{ThemeResource LumaSurfaceBrush}" BorderBrush="{ThemeResource LumaBorderSubtleBrush}" BorderThickness="1">
        <Grid Margin="14,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <c:LucideIcon Data="{StaticResource Icon.Search}" Size="18" Foreground="{ThemeResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="PageSearch" Grid.Column="1" Style="{StaticResource BareTextBoxStyle}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                   Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search your favorites" AutomationProperties.Name="Search favorites" />
        </Grid>
      </Border>
      <ComboBox x:Name="ProviderCombo" Grid.Column="1" Height="44" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter by source" />
      <ComboBox x:Name="SortCombo" Grid.Column="2" Height="44" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort favorites" />
    </Grid>

    <Grid Grid.Row="2">
      <c:WallpaperGrid ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                       IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                       Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.IsEmpty), Mode=OneWay, FallbackValue=Visible}" />

      <c:EmptyState Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.Heart}" Heading="No favorites yet"
                    Message="Tap the heart on any wallpaper to keep it here. Favorites are saved on this computer, so they stay available even when a source is offline.">
        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Discover wallpapers" Command="{x:Bind ViewModel.BrowseDiscoverCommand, Mode=OneWay}" />
      </c:EmptyState>
    </Grid>
  </Grid>
</UserControl>
