<UserControl
    x:Class="Luma.App.Views.LibraryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    IsTabStop="False">

  <!-- DataContext / ViewModel: LibraryItemViewModel -->
  <Border Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="16">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource CardButtonStyle}" Padding="0" CornerRadius="10" Command="{x:Bind ViewModel.PreviewCommand, Mode=OneWay}"
              ToolTipService.ToolTip="Preview" AutomationProperties.Name="Preview">
        <Grid Width="136" Height="80" CornerRadius="10" Background="{ThemeResource LumaSkeletonBrush}">
          <c:ThumbnailImage Source="{x:Bind ViewModel.ThumbnailSource, Mode=OneWay}" DecodeWidth="320" CornerRadius="10" />
          <c:LucideIcon Data="{StaticResource Icon.Alert}" Size="20" Foreground="{ThemeResource LumaWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.FileMissing, Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>
      </Button>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Style="{StaticResource PillBorderStyle}">
            <TextBlock Text="{x:Bind ViewModel.ProviderName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource LumaTextSecondaryBrush}" />
          </Border>
          <Border Style="{StaticResource PillBorderStyle}" Background="{ThemeResource LumaWarningSubtleBrush}"
                  Visibility="{x:Bind ViewModel.FileMissing, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="File missing" FontSize="11" Foreground="{ThemeResource LumaWarningBrush}" />
          </Border>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ApplyCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.FileExists, Mode=OneWay, FallbackValue=False}"
                ToolTipService.ToolTip="Set as wallpaper" AutomationProperties.Name="Set as wallpaper">
          <c:LucideIcon Data="{StaticResource Icon.Monitor}" Size="18" />
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ShowInFolderCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.FileExists, Mode=OneWay, FallbackValue=False}"
                ToolTipService.ToolTip="Show in folder" AutomationProperties.Name="Show in folder">
          <c:LucideIcon Data="{StaticResource Icon.FolderOpen}" Size="18" />
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More" AutomationProperties.Name="More actions">
          <c:LucideIcon Data="{StaticResource Icon.More}" Size="18" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem Text="Remove from library" Command="{x:Bind ViewModel.RemoveCommand, Mode=OneWay}" />
              <MenuFlyoutItem Text="Delete file from disk…" Command="{x:Bind ViewModel.DeleteFileCommand, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.FileExists, Mode=OneWay, FallbackValue=False}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
