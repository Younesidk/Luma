<UserControl
    x:Class="Luma.App.Views.DownloadJobRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    IsTabStop="False">

  <!-- DataContext / ViewModel: DownloadJobViewModel -->
  <Border Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="14">
    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="72" Height="44" CornerRadius="8" Background="{ThemeResource LumaSkeletonBrush}">
        <c:ThumbnailImage Source="{x:Bind ViewModel.ThumbnailSource, Mode=OneWay}" DecodeWidth="200" CornerRadius="8" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
        <ProgressBar Style="{StaticResource LumaProgressBarStyle}" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                     IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay, FallbackValue=Collapsed}" />
        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay, FallbackValue=Collapsed}"
              ToolTipService.ToolTip="Cancel download" AutomationProperties.Name="Cancel download">
        <c:LucideIcon Data="{StaticResource Icon.Close}" Size="16" />
      </Button>
      <c:LucideIcon Grid.Column="2" Data="{StaticResource Icon.Check}" Size="18" Foreground="{ThemeResource LumaSuccessBrush}" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay, FallbackValue=Collapsed}" />
      <c:LucideIcon Grid.Column="2" Data="{StaticResource Icon.Alert}" Size="18" Foreground="{ThemeResource LumaErrorBrush}" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay, FallbackValue=Collapsed}" />
    </Grid>
  </Border>
</UserControl>
