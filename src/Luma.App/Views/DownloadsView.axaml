<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             x:Class="Luma.App.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <Grid Grid.Row="0" Margin="32,4,32,0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Downloads" Classes="display" />
        <TextBlock Text="{Binding Summary}" Classes="secondary" FontSize="14" IsVisible="{Binding HasItems}" />
        <TextBlock Text="Wallpapers you download live here and stay available offline." Classes="secondary" FontSize="14" IsVisible="{Binding !HasItems}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Bottom" Height="42" Command="{Binding ImportCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Upload}" Size="16" /><TextBlock Text="Import images" /></StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" Margin="32,22,32,12" ColumnDefinitions="*,190" ColumnSpacing="10" IsVisible="{Binding !IsEmpty}">
      <Border Height="44" CornerRadius="13" Background="{DynamicResource LumaSurfaceBrush}" BorderBrush="{DynamicResource LumaBorderSubtleBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*" Margin="14,0,12,0">
          <c:Icon Data="{StaticResource Icon.Search}" Size="18" Foreground="{DynamicResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="PageSearch" Grid.Column="1" Classes="bare" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                   Text="{Binding SearchText}" PlaceholderText="Search downloads" AutomationProperties.Name="Search downloads" />
        </Grid>
      </Border>
      <ComboBox Grid.Column="1" Height="44" HorizontalAlignment="Stretch" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="Sort downloads" />
    </Grid>

    <!-- Active transfers -->
    <StackPanel Grid.Row="2" Margin="32,4,32,12" Spacing="10" IsVisible="{Binding HasJobs}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Transfers" Classes="section" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Width="NaN" Padding="10,6" Height="30" Command="{Binding ClearFinishedCommand}" IsVisible="{Binding HasFinishedJobs}">
          <TextBlock Text="Clear finished" FontSize="12" Foreground="{DynamicResource LumaAccentSecondaryBrush}" />
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding Jobs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DownloadJobViewModel">
            <Border Classes="card" Padding="12" CornerRadius="14">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="72" Height="44" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource LumaSkeletonBrush}">
                  <c:ThumbnailImage Source="{Binding ThumbnailSource}" DecodeWidth="200" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsActive}" />
                  <TextBlock Text="{Binding StatusText}" Classes="meta" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" ToolTip.Tip="Cancel download" AutomationProperties.Name="Cancel download">
                  <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
                </Button>
                <c:Icon Grid.Column="2" Data="{StaticResource Icon.Check}" Size="18" Foreground="{DynamicResource LumaSuccessBrush}" IsVisible="{Binding IsDone}" VerticalAlignment="Center" />
                <c:Icon Grid.Column="2" Data="{StaticResource Icon.Alert}" Size="18" Foreground="{DynamicResource LumaErrorBrush}" IsVisible="{Binding IsFailed}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Library -->
    <Grid Grid.Row="3">
      <ListBox Classes="plain" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}" Padding="32,4,32,28">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryItemViewModel">
            <Border Classes="card" Padding="12" CornerRadius="16" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Button Padding="0" CornerRadius="10" Command="{Binding PreviewCommand}" AutomationProperties.Name="Preview" ClipToBounds="True">
                  <Border Width="136" Height="80" Background="{DynamicResource LumaSkeletonBrush}">
                    <Panel>
                      <c:ThumbnailImage Source="{Binding ThumbnailSource}" DecodeWidth="320" />
                      <c:Icon Data="{StaticResource Icon.Alert}" Size="20" Foreground="{DynamicResource LumaWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding FileMissing}" />
                    </Panel>
                  </Border>
                </Button>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding MetaText}" Classes="meta" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="pill"><TextBlock Text="{Binding ProviderName}" FontSize="11" Foreground="{DynamicResource LumaTextSecondaryBrush}" /></Border>
                    <Border Classes="pill" Background="{DynamicResource LumaWarningSubtleBrush}" IsVisible="{Binding FileMissing}"><TextBlock Text="File missing" FontSize="11" Foreground="{DynamicResource LumaWarningBrush}" /></Border>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Classes="icon" Command="{Binding ApplyCommand}" IsEnabled="{Binding FileExists}" ToolTip.Tip="Set as wallpaper" AutomationProperties.Name="Set as wallpaper"><c:Icon Data="{StaticResource Icon.Monitor}" Size="18" /></Button>
                  <Button Classes="icon" Command="{Binding ShowInFolderCommand}" IsEnabled="{Binding FileExists}" ToolTip.Tip="Show in folder" AutomationProperties.Name="Show in folder"><c:Icon Data="{StaticResource Icon.FolderOpen}" Size="18" /></Button>
                  <Button Classes="icon" ToolTip.Tip="More" AutomationProperties.Name="More actions">
                    <c:Icon Data="{StaticResource Icon.More}" Size="18" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Remove from library" Command="{Binding RemoveCommand}" />
                        <MenuItem Header="Delete file from disk…" Command="{Binding DeleteFileCommand}" IsEnabled="{Binding FileExists}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Download}" Heading="Nothing downloaded yet"
                    Message="Download a wallpaper to keep a full-resolution copy on this computer. You can also import images you already have.">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="secondary" Content="Import images" Command="{Binding ImportCommand}" />
          <Button Classes="primary" Content="Discover wallpapers" Command="{Binding BrowseDiscoverCommand}" />
        </StackPanel>
      </c:EmptyState>
      <c:EmptyState IsVisible="{Binding NoResults}" Icon="{StaticResource Icon.Search}" Heading="No matches" Message="None of your downloads match that search." />
    </Grid>
  </Grid>
</UserControl>

