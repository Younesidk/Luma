<UserControl
    x:Class="Luma.App.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: HistoryViewModel (set by MainWindow.CreatePageView). Rows are HistoryRow (internal row view model). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="32,4,32,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="History" Style="{StaticResource DisplayTextStyle}" />
        <TextBlock Text="Every wallpaper you've applied, newest first." Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource DangerGhostButtonStyle}" VerticalAlignment="Bottom" Height="42"
              Command="{x:Bind ViewModel.ClearCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay, FallbackValue=Collapsed}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:LucideIcon Data="{StaticResource Icon.Trash}" Size="15" VerticalAlignment="Center" />
          <TextBlock Text="Clear history" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay, FallbackValue=Collapsed}" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" Margin="32,0,32,28">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="10" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <v:HistoryRow />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <c:EmptyState Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.History}" Heading="No history yet"
                    Message="When you set a wallpaper, it shows up here so you can bring any of them back with one click.">
        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Discover wallpapers" Command="{x:Bind ViewModel.BrowseDiscoverCommand, Mode=OneWay}" />
      </c:EmptyState>
    </Grid>
  </Grid>
</UserControl>
