<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:svc="using:Luma.App.Services"
             xmlns:v="using:Luma.App.Views"
             x:Class="Luma.App.Views.CollectionPickerDialogView"
             x:DataType="svc:CollectionPickerDialogViewModel">
  <Border Classes="popup" Width="460" Padding="28" CornerRadius="20" Background="{DynamicResource LumaDialogBrush}">
    <StackPanel Spacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="Add to collection" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Wallpaper.DisplayTitle}" Classes="meta" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Panel>
        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:CollectionChoiceViewModel">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" CornerRadius="12"
                        Command="{Binding $parent[ItemsControl].((svc:CollectionPickerDialogViewModel)DataContext).ToggleCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Collection.Name}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Collection.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding CountText}" Classes="meta" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                            Background="{Binding IsMember, Converter={x:Static v:CheckBrushConverter.Instance}}">
                      <c:Icon Data="{StaticResource Icon.Check}" Size="14" Foreground="{DynamicResource LumaOnAccentBrush}" IsVisible="{Binding IsMember}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="You don't have any collections yet. Create your first one below." Classes="secondary" TextWrapping="Wrap"
                   IsVisible="{Binding IsEmpty}" />
      </Panel>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBox x:Name="NewNameBox" Text="{Binding NewName}" PlaceholderText="New collection name" MaxLength="120" AutomationProperties.Name="New collection name">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="secondary" Command="{Binding CreateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{StaticResource Icon.Plus}" Size="16" /><TextBlock Text="Create" /></StackPanel>
        </Button>
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource LumaErrorBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Button Classes="primary" Content="Done" Command="{Binding DoneCommand}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</UserControl>


