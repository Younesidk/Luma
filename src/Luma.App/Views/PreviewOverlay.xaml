<UserControl
    x:Class="Luma.App.Views.PreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:v="using:Luma.App.Views"
    RequestedTheme="Dark"
    Foreground="{ThemeResource LumaTextPrimaryBrush}">

  <!-- ViewModel: PreviewViewModel (set by MainWindow). Always dark, whatever the app theme: imagery reads best on black. -->
  <UserControl.Resources>
    <Style x:Key="FactKeyTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource LumaTextTertiaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FactValueTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Prev/next: 46px round, darker glass than the default GlassButtonStyle. -->
    <Style x:Key="NavigateButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Background" Value="#990B0D16" />
      <Setter Property="Foreground" Value="#F3F3FA" />
    </Style>
    <Style x:Key="TagTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{ThemeResource LumaTextSecondaryBrush}" />
    </Style>
    <Style x:Key="SidebarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Backdrop" Background="#F2090B12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="372" />
    </Grid.ColumnDefinitions>

    <!-- ============ Image stage ============ -->
    <Grid x:Name="Stage" Grid.Column="0" Background="Transparent">
      <Border x:Name="ImageFrame" Margin="64,72,64,56" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16"
              Translation="0,0,48"
              Visibility="{x:Bind v:BindHelpers.VisibleIfNotNull(ViewModel.Image), Mode=OneWay, FallbackValue=Collapsed}">
        <Border.Shadow>
          <ThemeShadow />
        </Border.Shadow>
        <Image x:Name="StageImage" Source="{x:Bind ViewModel.Image, Mode=OneWay}" Stretch="Uniform" />
      </Border>

      <!-- Loading skeleton (no thumbnail yet) / error -->
      <Border Margin="64,72,64,56" CornerRadius="16" MaxWidth="1100" MaxHeight="660" Background="#1A1F2E"
              c:Skeleton.IsAnimated="True"
              Visibility="{x:Bind v:BindHelpers.VisibleIfNull(ViewModel.Image), Mode=OneWay, FallbackValue=Visible}">
        <c:EmptyState Heading="{x:Bind ViewModel.ImageError, Mode=OneWay}" Icon="{StaticResource Icon.Image}" IsDanger="True"
                      Visibility="{x:Bind v:BindHelpers.VisibleIfNotEmpty(ViewModel.ImageError), Mode=OneWay, FallbackValue=Collapsed}">
          <Button Style="{StaticResource SecondaryButtonStyle}" Content="Try again" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />
        </c:EmptyState>
      </Border>

      <!-- Top bar (inside the window's drag strip; MainWindow makes these pass-through) -->
      <Grid VerticalAlignment="Top" Margin="24,20,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="CloseButton" Style="{StaticResource GlassButtonStyle}" Width="40" Height="40" CornerRadius="20"
                Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close preview">
          <c:LucideIcon Data="{StaticResource Icon.Close}" Size="18" />
        </Button>
        <Border Grid.Column="2" Background="#8C0B0D16" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"
                Visibility="{x:Bind v:BindHelpers.VisibleIfNotEmpty(ViewModel.PositionText), Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" FontSize="12" Foreground="#D9F3F3FA" />
        </Border>
      </Grid>

      <!-- Previous / next -->
      <Button Style="{StaticResource NavigateButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
              Command="{x:Bind ViewModel.PreviousCommand, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.HasPrevious, Mode=OneWay, FallbackValue=Collapsed}"
              ToolTipService.ToolTip="Previous (←)" AutomationProperties.Name="Previous wallpaper">
        <c:LucideIcon Data="{StaticResource Icon.ChevronLeft}" Size="22" />
      </Button>
      <Button Style="{StaticResource NavigateButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
              Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.HasNext, Mode=OneWay, FallbackValue=Collapsed}"
              ToolTipService.ToolTip="Next (→)" AutomationProperties.Name="Next wallpaper">
        <c:LucideIcon Data="{StaticResource Icon.ChevronRight}" Size="22" />
      </Button>

      <!-- Quality hint -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#8C0B0D16" CornerRadius="14" Padding="14,7"
              Visibility="{x:Bind ViewModel.IsRefiningImage, Mode=OneWay, FallbackValue=Collapsed}">
        <TextBlock Text="Loading full quality…" FontSize="12" Foreground="#D9F3F3FA" />
      </Border>
    </Grid>

    <!-- ============ Details ============ -->
    <Border Grid.Column="1" Background="{ThemeResource LumaSidebarBrush}" BorderBrush="{ThemeResource LumaBorderSubtleBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <!-- Top margin clears the window's caption buttons, which sit over this column. -->
        <StackPanel Margin="28,56,28,28" Spacing="22">

          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" CharacterSpacing="-14" TextWrapping="Wrap" LineHeight="26" />
            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasCreator, Mode=OneWay, FallbackValue=Collapsed}">
              <TextBlock Text="by" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
              <Button Style="{StaticResource LinkButtonStyle}" Content="{x:Bind ViewModel.CreatorName, Mode=OneWay}" FontWeight="Medium"
                      Command="{x:Bind ViewModel.OpenCreatorCommand, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Style="{StaticResource PillBorderStyle}">
                <TextBlock Text="{x:Bind ViewModel.ProviderName, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource LumaTextSecondaryBrush}" />
              </Border>
              <Border Style="{StaticResource PillBorderStyle}">
                <TextBlock Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource LumaTextSecondaryBrush}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Primary action -->
          <StackPanel Spacing="10">
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.CanApply, Mode=OneWay, FallbackValue=Collapsed}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="46"
                      Command="{x:Bind ViewModel.ApplyCommand, Mode=OneWay}"
                      IsEnabled="{x:Bind v:BindHelpers.Not(ViewModel.IsApplying), Mode=OneWay, FallbackValue=True}">
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                  <c:LucideIcon Data="{StaticResource Icon.Monitor}" Size="18" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ComboBox x:Name="FitCombo" Grid.Column="1" Width="112" Height="46" MinWidth="0"
                        ToolTipService.ToolTip="How the wallpaper fits the screen" AutomationProperties.Name="Fit mode" />
            </Grid>
            <ProgressBar Style="{StaticResource LumaProgressBarStyle}" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.ApplyProgress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsApplying, Mode=OneWay, FallbackValue=Collapsed}" />
            <TextBlock Text="{x:Bind ViewModel.ApplyNote, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.CanApply), Mode=OneWay, FallbackValue=Collapsed}" />

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{x:Bind ViewModel.DownloadCommand, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Item.CanDownload, Mode=OneWay, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:LucideIcon Data="{StaticResource Icon.Download}" Size="16" VerticalAlignment="Center" /><TextBlock Text="Download" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{x:Bind ViewModel.ShowInFolderCommand, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Item.IsDownloaded, Mode=OneWay, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:LucideIcon Data="{StaticResource Icon.FolderOpen}" Size="16" VerticalAlignment="Center" /><TextBlock Text="In library" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SidebarActionButtonStyle}" IsEnabled="False"
                      Visibility="{x:Bind ViewModel.Item.IsDownloading, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock Text="Downloading…" HorizontalAlignment="Center" />
              </Button>
              <Button Grid.Column="1" Style="{StaticResource SidebarActionButtonStyle}" Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}"
                      AutomationProperties.Name="Toggle favorite">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:LucideIcon Data="{StaticResource Icon.Heart}" Size="16" VerticalAlignment="Center"
                                IsFilled="{x:Bind ViewModel.Item.IsFavorite, Mode=OneWay, FallbackValue=False}" />
                  <TextBlock Text="{x:Bind v:BindHelpers.FavoriteText(ViewModel.Item.IsFavorite), Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <ProgressBar Style="{StaticResource LumaProgressBarStyle}" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Item.DownloadProgress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.Item.IsDownloading, Mode=OneWay, FallbackValue=Collapsed}" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{x:Bind ViewModel.AddToCollectionCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:LucideIcon Data="{StaticResource Icon.FolderPlus}" Size="16" VerticalAlignment="Center" /><TextBlock Text="Collection" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource SidebarActionButtonStyle}" Command="{x:Bind ViewModel.OpenSourceCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:LucideIcon Data="{StaticResource Icon.ExternalLink}" Size="16" VerticalAlignment="Center" /><TextBlock Text="Source page" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <Border Style="{StaticResource DividerBorderStyle}" />

          <!-- Facts -->
          <Grid RowSpacing="11" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Resolution" Style="{StaticResource FactKeyTextStyle}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" Style="{StaticResource FactValueTextStyle}" />
            <TextBlock Grid.Row="1" Text="Aspect ratio" Style="{StaticResource FactKeyTextStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AspectText, Mode=OneWay}" Style="{StaticResource FactValueTextStyle}" />
            <TextBlock Grid.Row="2" Text="File size" Style="{StaticResource FactKeyTextStyle}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" Style="{StaticResource FactValueTextStyle}" />
            <TextBlock Grid.Row="3" Text="Format" Style="{StaticResource FactKeyTextStyle}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.FileTypeText, Mode=OneWay}" Style="{StaticResource FactValueTextStyle}" />
            <TextBlock Grid.Row="4" Text="Provider" Style="{StaticResource FactKeyTextStyle}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ProviderName, Mode=OneWay}" Style="{StaticResource FactValueTextStyle}" />
            <TextBlock Grid.Row="5" Text="Category" Style="{StaticResource FactKeyTextStyle}"
                       Visibility="{x:Bind ViewModel.HasCategory, Mode=OneWay, FallbackValue=Collapsed}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.CategoryText, Mode=OneWay}" Style="{StaticResource FactValueTextStyle}"
                       Visibility="{x:Bind ViewModel.HasCategory, Mode=OneWay, FallbackValue=Collapsed}" />
          </Grid>

          <!-- Colours (swatches built in code-behind) -->
          <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasColors, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="Palette" Style="{StaticResource FactKeyTextStyle}" />
            <StackPanel x:Name="PalettePanel" Orientation="Horizontal" Spacing="8" />
          </StackPanel>

          <!-- Tags (pills built in code-behind) -->
          <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="Tags" Style="{StaticResource FactKeyTextStyle}" />
            <c:WrapPanel x:Name="TagsPanel" />
          </StackPanel>

          <!-- License / attribution -->
          <Border Style="{StaticResource CardBorderStyle}" Padding="16" CornerRadius="14"
                  Visibility="{x:Bind ViewModel.HasLicense, Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Spacing="9">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:LucideIcon Data="{StaticResource Icon.Scale}" Size="16" Foreground="{ThemeResource LumaTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.LicenseName, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.Attribution, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" IsTextSelectionEnabled="True"
                         TextWrapping="Wrap" LineHeight="18" Visibility="{x:Bind ViewModel.HasAttribution, Mode=OneWay, FallbackValue=Collapsed}" />
              <TextBlock Text="Credit the creator when you share or reuse this image." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
              <Button Style="{StaticResource LinkButtonStyle}" Content="View license" Command="{x:Bind ViewModel.OpenLicenseCommand, Mode=OneWay}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
