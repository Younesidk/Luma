<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             x:Class="Luma.App.Views.CollectionsView"
             x:DataType="vm:CollectionsViewModel">

  <UserControl.Styles>
    <Style Selector="Button.collection">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.collection:pointerover"><Setter Property="RenderTransform" Value="scale(1.015)" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.collection:pressed"><Setter Property="Background" Value="Transparent" /></Style>
  </UserControl.Styles>

  <Grid>
    <!-- ================= Overview ================= -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsOverview}">
      <Grid Grid.Row="0" Margin="32,4,32,20" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Collections" Classes="display" />
          <TextBlock Text="Group wallpapers any way you like. Deleting a collection never deletes the wallpapers." Classes="secondary" FontSize="14" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Command="{Binding CreateCommand}" VerticalAlignment="Bottom" Height="42">
          <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Plus}" Size="16" /><TextBlock Text="New collection" /></StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsOverviewEmpty}">
        <ItemsControl ItemsSource="{Binding Collections}" Margin="32,0,32,32">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CollectionCardViewModel">
              <Button Classes="collection" Width="290" Margin="0,0,20,24"
                      Command="{Binding $parent[ItemsControl].((vm:CollectionsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Name}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" Command="{Binding $parent[ItemsControl].((vm:CollectionsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Edit…" Command="{Binding $parent[ItemsControl].((vm:CollectionsViewModel)DataContext).RenameCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Delete collection…" Command="{Binding $parent[ItemsControl].((vm:CollectionsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Spacing="12">
                  <Border Height="180" CornerRadius="18" ClipToBounds="True" Background="{DynamicResource LumaSurfaceBrush}"
                          BorderBrush="{DynamicResource LumaBorderSubtleBrush}" BorderThickness="1">
                    <Panel>
                      <c:Icon Data="{StaticResource Icon.Layers}" Size="34" Foreground="{DynamicResource LumaTextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
                      <c:ThumbnailImage Source="{Binding Cover1}" IsVisible="{Binding HasSingleCover}" DecodeWidth="520" />
                      <Grid IsVisible="{Binding HasMosaic}" RowDefinitions="*,*" ColumnDefinitions="*,*">
                        <c:ThumbnailImage Source="{Binding Cover1}" Margin="0,0,1,1" />
                        <c:ThumbnailImage Grid.Column="1" Source="{Binding Cover2}" Margin="1,0,0,1" />
                        <c:ThumbnailImage Grid.Row="1" Source="{Binding Cover3}" Margin="0,1,1,0" />
                        <c:ThumbnailImage Grid.Row="1" Grid.Column="1" Source="{Binding Cover4}" Margin="1,1,0,0" />
                      </Grid>
                    </Panel>
                  </Border>
                  <StackPanel Spacing="2" Margin="4,0,4,0">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountText}" Classes="meta" />
                  </StackPanel>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <c:EmptyState Grid.Row="1" IsVisible="{Binding IsOverviewEmpty}" Icon="{StaticResource Icon.Layers}" Heading="Create your first collection"
                    Message="Collections are perfect for moods, projects or a desk setup: Dark wallpapers, Nature, Anime, Favorites for later.">
        <Button Classes="primary" Command="{Binding CreateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Plus}" Size="16" /><TextBlock Text="New collection" /></StackPanel>
        </Button>
      </c:EmptyState>
    </Grid>

    <!-- ================= Detail ================= -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsDetail}">
      <Grid Grid.Row="0" Margin="32,4,32,20" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Button Classes="secondary" Width="44" Height="44" Padding="0" CornerRadius="13" Command="{Binding BackCommand}" VerticalAlignment="Top" Margin="0,6,0,0"
                ToolTip.Tip="All collections" AutomationProperties.Name="Back to collections">
          <c:Icon Data="{StaticResource Icon.ArrowLeft}" Size="18" />
        </Button>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding Current.Name}" Classes="display" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Current.Description}" Classes="secondary" FontSize="14" TextWrapping="Wrap" IsVisible="{Binding Current.HasDescription}" />
          <TextBlock Text="{Binding Current.CountText}" Classes="meta" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Classes="secondary" Command="{Binding RenameCommand}" CommandParameter="{x:Null}">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Pencil}" Size="15" /><TextBlock Text="Edit" /></StackPanel>
          </Button>
          <Button Classes="secondary danger-ghost" Command="{Binding DeleteCommand}" CommandParameter="{x:Null}">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Trash}" Size="15" /><TextBlock Text="Delete" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <c:WallpaperGrid Grid.Row="1" ItemsSource="{Binding Items}" IsVisible="{Binding !DetailIsEmpty}" />
      <c:EmptyState Grid.Row="1" IsVisible="{Binding DetailIsEmpty}" Icon="{StaticResource Icon.FolderPlus}" Heading="This collection is empty"
                    Message="Open any wallpaper and choose Collection to add it here." />
    </Grid>
  </Grid>
</UserControl>
