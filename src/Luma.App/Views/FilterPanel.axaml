<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             xmlns:v="using:Luma.App.Views"
             x:Class="Luma.App.Views.FilterPanel"
             x:DataType="vm:DiscoverViewModel">
  <Border Classes="popup" Width="420" Padding="0" BoxShadow="none">
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22" Spacing="18">

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon" Width="NaN" Padding="10,6" Height="30" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasFilters}">
            <TextBlock Text="Clear all" FontSize="12" Foreground="{DynamicResource LumaAccentSecondaryBrush}" />
          </Button>
        </Grid>

        <TextBlock Text="{Binding FilterScopeNote}" Classes="meta" TextWrapping="Wrap" LineHeight="17" IsVisible="{Binding FilterScopeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Spacing="8">
          <TextBlock Text="Sort by" Classes="label" />
          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Filters.SortOption}" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort order" />
          <ComboBox ItemsSource="{x:Static vm:DiscoverFilters.TopRanges}" SelectedItem="{Binding Filters.TopRangeOption}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowTopRange}" AutomationProperties.Name="Top list range" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowCategories}">
          <TextBlock Text="Category" Classes="label" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton Classes="chip" Content="General" IsChecked="{Binding Filters.General}" />
            <ToggleButton Classes="chip" Content="Anime" IsChecked="{Binding Filters.Anime}" />
            <ToggleButton Classes="chip" Content="People" IsChecked="{Binding Filters.People}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowPurity}">
          <TextBlock Text="Content" Classes="label" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton Classes="chip" Content="Safe" IsChecked="{Binding Filters.Safe}" />
            <ToggleButton Classes="chip" Content="Sketchy" IsChecked="{Binding Filters.Sketchy}" />
            <ToggleButton Classes="chip" Content="Explicit" IsChecked="{Binding Filters.ExplicitContent}" IsVisible="{Binding ShowExplicit}" />
          </StackPanel>
          <TextBlock Text="Explicit content needs a Wallhaven API key (Settings → Providers)." Classes="meta" TextWrapping="Wrap" IsVisible="{Binding !ShowExplicit}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding ShowMinResolution}">
          <StackPanel Spacing="8">
            <TextBlock Text="Resolution" Classes="label" />
            <ComboBox ItemsSource="{x:Static vm:DiscoverFilters.Resolutions}" SelectedItem="{Binding Filters.MinResolutionOption}" HorizontalAlignment="Stretch" AutomationProperties.Name="Minimum resolution" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding ShowAspect}">
            <TextBlock Text="Shape" Classes="label" />
            <ComboBox ItemsSource="{x:Static vm:DiscoverFilters.Aspects}" SelectedItem="{Binding Filters.AspectOption}" HorizontalAlignment="Stretch" AutomationProperties.Name="Aspect ratio" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8" IsVisible="{Binding ShowContentKind}">
          <TextBlock Text="Type" Classes="label" />
          <ComboBox ItemsSource="{x:Static vm:DiscoverFilters.ContentKinds}" SelectedItem="{Binding Filters.ContentKindOption}" HorizontalAlignment="Stretch" AutomationProperties.Name="Content type" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowLicense}">
          <TextBlock Text="License" Classes="label" />
          <ComboBox ItemsSource="{x:Static vm:DiscoverFilters.Licenses}" SelectedItem="{Binding Filters.LicenseOption}" HorizontalAlignment="Stretch" AutomationProperties.Name="License" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding ShowColors}">
          <TextBlock Text="Colour" Classes="label" />
          <ItemsControl ItemsSource="{Binding Filters.Colors}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColorChoice">
                <Button Width="30" Height="30" Padding="0" CornerRadius="15" Margin="0,0,8,8" BorderThickness="2"
                        Background="{Binding Hex, Converter={x:Static v:HexBrushConverter.Instance}}"
                        BorderBrush="{Binding IsSelected, Converter={x:Static v:CheckBrushConverter.Instance}}"
                        Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).Filters.ToggleColorCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
