<UserControl
    x:Class="Luma.App.Views.HistoryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    IsTabStop="False">

  <!-- DataContext / ViewModel: HistoryEntryViewModel -->
  <Border Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="16">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource CardButtonStyle}" Padding="0" CornerRadius="10" Command="{x:Bind ViewModel.PreviewCommand, Mode=OneWay}"
              ToolTipService.ToolTip="Preview" AutomationProperties.Name="Preview">
        <Border Width="136" Height="80" CornerRadius="10" Background="{ThemeResource LumaSkeletonBrush}">
          <c:ThumbnailImage Source="{x:Bind ViewModel.ThumbnailSource, Mode=OneWay}" DecodeWidth="320" CornerRadius="10" />
        </Border>
      </Button>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind ViewModel.AppliedText, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource LumaAccentSecondaryBrush}" />
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.ReapplyCommand, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LucideIcon Data="{StaticResource Icon.Refresh}" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="Apply again" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ShowInFolderCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay, FallbackValue=False}"
                ToolTipService.ToolTip="Show in folder" AutomationProperties.Name="Show in folder">
          <c:LucideIcon Data="{StaticResource Icon.FolderOpen}" Size="18" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
