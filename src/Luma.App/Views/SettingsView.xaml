<UserControl
    x:Class="Luma.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:vm="using:Luma.App.ViewModels"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <UserControl.Resources>
    <Style x:Key="SettingToggleStyle" TargetType="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0,0,-12,0" />
    </Style>
    <!-- Accent swatch: a 30px colour dot whose 2px ring shows selection (set from code-behind). -->
    <Style x:Key="SwatchButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- ViewModel: SettingsViewModel (set by MainWindow.CreatePageView). ComboBoxes, sliders and accent swatches are wired in code-behind.
       There is no renderer (software / GPU) row: WinUI always renders with DirectX. AppSettings keeps the old value. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <StackPanel Margin="32,4,32,48" Spacing="32" MaxWidth="820" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="Settings" Style="{StaticResource DisplayTextStyle}" />
        <TextBlock Text="Make Luma feel like yours." Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
      </StackPanel>

      <!-- ================= Appearance ================= -->
      <StackPanel>
        <TextBlock Text="Appearance" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <c:SettingRow Heading="Theme" Description="Dark is the default. Match system follows your operating system.">
              <ComboBox x:Name="ThemeCombo" Width="190" AutomationProperties.Name="Theme" />
            </c:SettingRow>
            <c:SettingRow Heading="Accent colour" Description="Used for highlights, buttons and the active sidebar item.">
              <StackPanel x:Name="AccentStrip" Orientation="Horizontal" Spacing="8" />
            </c:SettingRow>
            <c:SettingRow Heading="Gallery density" Description="Compact fits more wallpapers on screen.">
              <ComboBox x:Name="DensityCombo" Width="190" AutomationProperties.Name="Gallery density" />
            </c:SettingRow>
            <c:SettingRow Heading="Compact sidebar" Description="Show only icons in the sidebar.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.SidebarCompact, Mode=TwoWay}" AutomationProperties.Name="Compact sidebar" />
            </c:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Downloads ================= -->
      <StackPanel>
        <TextBlock Text="Downloads" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <c:SettingRow Heading="Download location" Description="{x:Bind ViewModel.DownloadDirectoryText, Mode=OneWay}" Stacked="True">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Choose folder…" Command="{x:Bind ViewModel.ChooseDownloadFolderCommand, Mode=OneWay}" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open" Command="{x:Bind ViewModel.OpenDownloadFolderCommand, Mode=OneWay}" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Use default" Command="{x:Bind ViewModel.ResetDownloadFolderCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.UsesCustomDownloadDirectory, Mode=OneWay, FallbackValue=Collapsed}" />
              </StackPanel>
            </c:SettingRow>
            <c:SettingRow Heading="Confirm before deleting files" Description="Always ask before a downloaded file is permanently removed from disk.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.ConfirmBeforeDelete, Mode=TwoWay}" AutomationProperties.Name="Confirm before deleting files" />
            </c:SettingRow>
            <c:SettingRow Heading="Image format" Description="Luma saves wallpapers exactly as the source provides them, so there is no quality loss from re-encoding." />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Providers ================= -->
      <StackPanel>
        <TextBlock Text="Providers" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <ItemsControl ItemsSource="{x:Bind ViewModel.ProviderStatuses, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderStatusViewModel">
                  <c:SettingRow Heading="{x:Bind Name}" Description="{x:Bind Limits}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <StackPanel Spacing="1" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                   Foreground="{ThemeResource LumaTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind RateInfo, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource LumaTextTertiaryBrush}"
                                   Visibility="{x:Bind HasRateInfo, Mode=OneWay}" />
                      </StackPanel>
                      <Button Style="{StaticResource SecondaryButtonStyle}" Content="Check" Command="{x:Bind CheckCommand}" Padding="14,7"
                              IsEnabled="{x:Bind v:BindHelpers.Not(IsChecking), Mode=OneWay}" />
                      <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" />
                    </StackPanel>
                  </c:SettingRow>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:SettingRow Heading="Wallhaven API key" Stacked="True"
                          Description="Optional. A key unlocks explicit content and your account's settings. It is stored in settings.json on this computer and is only ever sent to wallhaven.cc as a request header.">
              <PasswordBox Password="{x:Bind ViewModel.WallhavenApiKey, Mode=TwoWay}" PlaceholderText="Paste your key from wallhaven.cc/settings/account"
                           AutomationProperties.Name="Wallhaven API key" />
            </c:SettingRow>
            <c:SettingRow Heading="Openverse credentials" Stacked="True"
                          Description="Optional. Anonymous use allows 20 requests per minute, 200 per day, and 240 results per search. Register an application at api.openverse.org to raise those limits.">
              <StackPanel Spacing="8">
                <TextBox Text="{x:Bind ViewModel.OpenverseClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Client ID"
                         AutomationProperties.Name="Openverse client id" />
                <PasswordBox Password="{x:Bind ViewModel.OpenverseClientSecret, Mode=TwoWay}" PlaceholderText="Client secret"
                             AutomationProperties.Name="Openverse client secret" />
              </StackPanel>
            </c:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Wallpaper ================= -->
      <StackPanel>
        <TextBlock Text="Wallpaper" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <c:SettingRow Heading="This computer" Description="{x:Bind ViewModel.PlatformNote, Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.PlatformSummary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right" />
            </c:SettingRow>
            <c:SettingRow Heading="Default fit" Description="How wallpapers are laid out on screen when you apply them.">
              <ComboBox x:Name="FitCombo" Width="190" IsEnabled="{x:Bind ViewModel.CanApplyWallpapers, Mode=OneWay}" AutomationProperties.Name="Default fit mode" />
            </c:SettingRow>
            <c:SettingRow Heading="Default source" Description="What Discover shows when Luma starts.">
              <ComboBox x:Name="SourceCombo" Width="190" AutomationProperties.Name="Default source" />
            </c:SettingRow>
            <c:SettingRow Heading="Automatic rotation" Description="{x:Bind ViewModel.RotationStatus, Mode=OneWay}">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.RotationEnabled, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanApplyWallpapers, Mode=OneWay}" AutomationProperties.Name="Automatic rotation" />
            </c:SettingRow>
            <c:SettingRow Heading="Change every" Description="Rotation uses wallpapers you already downloaded, so it never needs the network.">
              <ComboBox x:Name="IntervalCombo" Width="190" AutomationProperties.Name="Rotation interval" />
            </c:SettingRow>
            <c:SettingRow Heading="Rotate through">
              <ComboBox x:Name="RotationSourceCombo" Width="230" AutomationProperties.Name="Rotation source" />
            </c:SettingRow>
            <c:SettingRow Heading="Collection" Visibility="{x:Bind ViewModel.ShowRotationCollection, Mode=OneWay}">
              <ComboBox x:Name="RotationCollectionCombo" Width="230" AutomationProperties.Name="Rotation collection" />
            </c:SettingRow>
            <c:SettingRow Heading="Random order" Description="Never repeats the current wallpaper while there are other choices. Off walks through them in order.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.RotationRandom, Mode=TwoWay}" AutomationProperties.Name="Random order" />
            </c:SettingRow>
            <c:SettingRow Heading="Change wallpaper now" IsEnabled="{x:Bind ViewModel.CanApplyWallpapers, Mode=OneWay}">
              <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RotateNowCommand, Mode=OneWay}"
                      IsEnabled="{x:Bind ViewModel.CanApplyWallpapers, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LucideIcon Data="{StaticResource Icon.Shuffle}" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Rotate now" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </c:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Live wallpapers ================= -->
      <StackPanel>
        <TextBlock Text="Live wallpapers" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <c:SettingRow Heading="This computer" Description="{x:Bind ViewModel.LiveWallpaperSupportNote, Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.LiveWallpaperSummary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            </c:SettingRow>
            <c:SettingRow Heading="Keep running in the background when closed"
                          Description="Closing the window keeps the live wallpaper and rotation going from the icon in the taskbar's notification area. Quit Luma from that icon.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                            AutomationProperties.Name="Keep running in the background when closed" />
            </c:SettingRow>
            <c:SettingRow Heading="Start with Windows" Visibility="{x:Bind ViewModel.CanLaunchAtLogin, Mode=OneWay}"
                          Description="Luma starts quietly in the notification area when you sign in and brings back your live wallpaper. You can also turn this off in Task Manager's Startup apps.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows" />
            </c:SettingRow>
            <c:SettingRow Heading="Pause during fullscreen apps and games"
                          Description="Stops the video on every display while a game or fullscreen app runs, freeing the graphics card. The video always pauses when it's completely hidden.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.VideoPauseOnFullscreen, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanUseLiveWallpapers, Mode=OneWay}" AutomationProperties.Name="Pause during fullscreen apps" />
            </c:SettingRow>
            <c:SettingRow Heading="Pause on battery power" Description="Saves battery on laptops. The video resumes when you plug in.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.VideoPauseOnBattery, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanUseLiveWallpapers, Mode=OneWay}" AutomationProperties.Name="Pause on battery power" />
            </c:SettingRow>
            <c:SettingRow Heading="Shrink videos larger than your screen"
                          Description="Imported videos with far more pixels than your largest display (for example 4K on a 1080p screen) are re-encoded at screen size. They look the same on the desktop but use much less memory while playing. Your original file is never changed.">
              <ToggleSwitch Style="{StaticResource SettingToggleStyle}" IsOn="{x:Bind ViewModel.VideoShrinkOnImport, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanUseLiveWallpapers, Mode=OneWay}" AutomationProperties.Name="Shrink videos larger than your screen" />
            </c:SettingRow>
            <c:SettingRow Heading="Video folder" Description="{x:Bind ViewModel.VideoStorageText, Mode=OneWay}">
              <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open" Command="{x:Bind ViewModel.OpenVideoFolderCommand, Mode=OneWay}" />
            </c:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Performance ================= -->
      <StackPanel>
        <TextBlock Text="Performance" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <c:SettingRow Heading="Thumbnail cache size" Description="Thumbnails are kept on disk so browsing is instant next time. Older ones are removed first.">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Slider x:Name="ThumbnailCacheSlider" Width="180" Minimum="64" Maximum="2048" StepFrequency="64" SmallChange="64" LargeChange="256"
                        TickFrequency="64" SnapsTo="StepValues" IsThumbToolTipEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Thumbnail cache size" />
                <TextBlock Text="{x:Bind ViewModel.ThumbnailCacheText, Mode=OneWay}" Width="70" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </c:SettingRow>
            <c:SettingRow Heading="Thumbnails kept in memory" Description="Fewer thumbnails use less RAM; more makes scrolling back smoother.">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Slider x:Name="MemoryCacheSlider" Width="180" Minimum="30" Maximum="400" StepFrequency="10" SmallChange="10" LargeChange="50"
                        TickFrequency="10" SnapsTo="StepValues" IsThumbToolTipEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Thumbnails kept in memory" />
                <TextBlock Text="{x:Bind ViewModel.MemoryCacheItemsText, Mode=OneWay}" Width="110" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </c:SettingRow>
            <c:SettingRow Heading="Simultaneous downloads">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Slider x:Name="DownloadsSlider" Width="180" Minimum="1" Maximum="8" StepFrequency="1" SmallChange="1" LargeChange="1"
                        TickFrequency="1" SnapsTo="StepValues" IsThumbToolTipEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Simultaneous downloads" />
                <TextBlock Text="{x:Bind ViewModel.MaxConcurrentDownloadsText, Mode=OneWay}" Width="110" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </c:SettingRow>
            <c:SettingRow Heading="Clear cache" Description="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}">
              <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear thumbnail cache" Command="{x:Bind ViewModel.ClearCacheCommand, Mode=OneWay}" />
            </c:SettingRow>
            <c:SettingRow Heading="Memory" Description="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= About ================= -->
      <StackPanel>
        <TextBlock Text="About Luma" Style="{StaticResource GroupTitleTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <c:SettingRow Heading="Luma" Description="Your desktop. Your atmosphere. A lightweight wallpaper manager for personal use.">
              <TextBlock Text="{x:Bind VersionText(ViewModel.Version), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            </c:SettingRow>
            <c:SettingRow Heading="Updates" Description="{x:Bind ViewModel.Updates.SettingsStatus, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Restart to update" Command="{x:Bind ViewModel.Updates.RestartCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Updates.IsReady, Mode=OneWay, FallbackValue=Collapsed}" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Update now" Command="{x:Bind ViewModel.Updates.UpdateNowCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Updates.IsAvailable, Mode=OneWay, FallbackValue=Collapsed}" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Check for updates" Command="{x:Bind ViewModel.Updates.CheckForUpdatesCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.Updates.CanCheck, Mode=OneWay, FallbackValue=False}"
                        Visibility="{x:Bind ViewModel.Updates.IsSupported, Mode=OneWay, FallbackValue=Collapsed}" />
              </StackPanel>
            </c:SettingRow>
            <c:SettingRow Heading="Data folder" Description="{x:Bind ViewModel.DataDirectory, Mode=OneWay}">
              <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open" Command="{x:Bind ViewModel.OpenDataFolderCommand, Mode=OneWay}" />
            </c:SettingRow>
            <c:SettingRow Heading="Logs" Description="{x:Bind ViewModel.LogsDirectory, Mode=OneWay}">
              <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open" Command="{x:Bind ViewModel.OpenLogsFolderCommand, Mode=OneWay}" />
            </c:SettingRow>
            <c:SettingRow Heading="Reset settings" Description="Restores every option above to its default. Favorites, collections and downloaded files are kept.">
              <Button Style="{StaticResource DangerGhostButtonStyle}" Content="Reset…" Command="{x:Bind ViewModel.ResetSettingsCommand, Mode=OneWay}" />
            </c:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
