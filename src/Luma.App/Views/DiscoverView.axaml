<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             xmlns:v="using:Luma.App.Views"
             x:Class="Luma.App.Views.DiscoverView"
             x:DataType="vm:DiscoverViewModel">

  <UserControl.Styles>
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="{DynamicResource LumaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LumaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem">
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource LumaTextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected"><Setter Property="Foreground" Value="{DynamicResource LumaTextPrimaryBrush}" /></Style>
    <Style Selector="ListBox.segmented > ListBoxItem /template/ Rectangle#SelectionIndicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border.hero-fade">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- ===== Heading ===== -->
    <StackPanel Grid.Row="0" Margin="32,4,32,0" Spacing="4">
      <TextBlock Text="Discover" Classes="display" />
      <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="14" />
    </StackPanel>

    <!-- ===== Search + filters ===== -->
    <Grid Grid.Row="1" Margin="32,22,32,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
      <Border Height="44" CornerRadius="13" Background="{DynamicResource LumaSurfaceBrush}" BorderBrush="{DynamicResource LumaBorderSubtleBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,8,0">
          <c:Icon Data="{StaticResource Icon.Search}" Size="18" Foreground="{DynamicResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="PageSearch" Grid.Column="1" Classes="bare" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="14"
                   Text="{Binding SearchText}" PlaceholderText="Search wallpapers, tags, places…" AutomationProperties.Name="Search wallpapers">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SubmitSearchCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="icon" Width="30" Height="30" CornerRadius="8" Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="Clear search" AutomationProperties.Name="Clear search">
            <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
          </Button>
        </Grid>
      </Border>

      <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" AutomationProperties.Name="Source">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SourceOption"><TextBlock Text="{Binding Label}" Foreground="{Binding $parent[ListBoxItem].Foreground}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button Grid.Column="2" Classes="secondary" Height="44" Padding="16,0" CornerRadius="13" AutomationProperties.Name="Filters">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <c:Icon Data="{StaticResource Icon.Sliders}" Size="17" />
          <TextBlock Text="Filters" VerticalAlignment="Center" />
          <Border Background="{DynamicResource LumaAccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center"
                  IsVisible="{Binding HasFilters}">
            <TextBlock Text="{Binding FilterBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LumaOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
            <v:FilterPanel />
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button Grid.Column="3" Classes="secondary" Width="44" Height="44" Padding="0" CornerRadius="13" Command="{Binding RefreshCommand}"
              ToolTip.Tip="Refresh (Ctrl R)" AutomationProperties.Name="Refresh">
        <c:Icon Data="{StaticResource Icon.Refresh}" Size="17" />
      </Button>
    </Grid>

    <!-- ===== Categories ===== -->
    <ScrollViewer Grid.Row="2" Margin="0,16,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Categories}" Margin="32,0,32,4">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryChip">
            <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsActive, Mode=OneWay}"
                          Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).SelectCategoryCommand}" CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ===== Gallery / states ===== -->
    <Grid Grid.Row="3" Margin="0,8,0,0">

      <!-- Partial failure notice -->
      <Border VerticalAlignment="Top" Margin="32,4,32,0" Padding="14,10" CornerRadius="12" ZIndex="2"
              Background="{DynamicResource LumaWarningSubtleBrush}" BorderBrush="{DynamicResource LumaWarningBrush}" BorderThickness="1"
              IsVisible="{Binding HasPartialWarning}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:Icon Data="{StaticResource Icon.Alert}" Size="16" Foreground="{DynamicResource LumaWarningBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding PartialWarning}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
          <Button Grid.Column="2" Classes="secondary" Content="Retry" Command="{Binding RetryCommand}" Padding="12,5" FontSize="12" />
        </Grid>
      </Border>

      <c:WallpaperGrid x:Name="Gallery" ItemsSource="{Binding Items}" IsLoading="{Binding IsLoading}" IsLoadingMore="{Binding IsLoadingMore}"
                       HasMore="{Binding HasMore}" LoadMoreCommand="{Binding LoadMoreCommand}"
                       IsVisible="{Binding !IsError}">
        <c:WallpaperGrid.Header>
          <v:FeaturedHero x:DataType="vm:DiscoverViewModel" Margin="0,6,14,24" IsVisible="{Binding HasFeatured}" />
        </c:WallpaperGrid.Header>
      </c:WallpaperGrid>

      <!-- Nothing matched -->
      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Search}" Heading="Nothing here yet"
                    Message="No wallpapers matched. Try a broader search, or loosen the filters.">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="secondary" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasFilters}" />
          <Button Classes="primary" Content="Clear search" Command="{Binding ClearSearchCommand}" />
        </StackPanel>
      </c:EmptyState>

      <!-- Failed -->
      <c:EmptyState IsVisible="{Binding IsError}" IsDanger="True" Icon="{StaticResource Icon.WifiOff}" Heading="{Binding ErrorTitle}" Message="{Binding ErrorDetail}">
        <Button Classes="primary" Command="{Binding RetryCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Refresh}" Size="16" /><TextBlock Text="Try again" /></StackPanel>
        </Button>
      </c:EmptyState>
    </Grid>
  </Grid>
</UserControl>


