<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:svc="using:Luma.App.Services"
             x:Class="Luma.App.Views.CollectionEditDialogView"
             x:DataType="svc:CollectionEditDialogViewModel">
  <Border Classes="popup" Width="460" Padding="28" CornerRadius="20" Background="{DynamicResource LumaDialogBrush}">
    <StackPanel Spacing="20">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="Name" Classes="meta" />
          <TextBox x:Name="NameBox" Text="{Binding Name}" PlaceholderText="Dark wallpapers, Desk setup, Anime…" MaxLength="120"
                   AutomationProperties.Name="Collection name">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" /></TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Description (optional)" Classes="meta" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="84" MaxLength="500"
                   PlaceholderText="What belongs in this collection?" AutomationProperties.Name="Collection description" />
        </StackPanel>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource LumaErrorBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="secondary" Content="Cancel" Command="{Binding CancelDialogCommand}" />
        <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

