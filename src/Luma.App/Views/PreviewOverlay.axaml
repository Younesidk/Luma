<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             xmlns:v="using:Luma.App.Views"
             xmlns:enums="using:Luma.Core.Enums"
             x:Class="Luma.App.Views.PreviewOverlay"
             x:DataType="vm:PreviewViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.key"><Setter Property="Foreground" Value="{DynamicResource LumaTextTertiaryBrush}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.value"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LumaAccentSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link:pointerover"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource LumaTextPrimaryBrush}" /></Style>
    <Style Selector="Button.navigate">
      <Setter Property="Width" Value="46" /><Setter Property="Height" Value="46" /><Setter Property="CornerRadius" Value="23" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#990B0D16" /><Setter Property="Foreground" Value="#F3F3FA" />
    </Style>
    <Style Selector="Button.navigate:pointerover"><Setter Property="Background" Value="#D90B0D16" /></Style>
  </UserControl.Styles>

  <ThemeVariantScope RequestedThemeVariant="Dark">
  <Grid Background="#F2090B12" ColumnDefinitions="*,372" x:Name="Backdrop">

    <!-- ============ Image stage ============ -->
    <Grid x:Name="Stage" Grid.Column="0" Background="Transparent">
      <Border x:Name="ImageFrame" Margin="64,72,64,56" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16"
              ClipToBounds="True" BoxShadow="0 24 70 0 #99000000" IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapInterpolationMode="HighQuality" />
      </Border>

      <!-- Loading skeleton (no thumbnail yet) -->
      <Border Classes="skeleton" Margin="64,72,64,56" CornerRadius="16" MaxWidth="1100" MaxHeight="660" Background="#1A1F2E"
              IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}">
        <c:EmptyState Heading="{Binding ImageError}" Icon="{StaticResource Icon.Image}" IsVisible="{Binding ImageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsDanger="True">
          <Button Classes="secondary" Content="Try again" Command="{Binding RetryCommand}" />
        </c:EmptyState>
      </Border>

      <!-- Top bar -->
      <Grid VerticalAlignment="Top" Margin="24,20,24,0" ColumnDefinitions="Auto,*,Auto">
        <Button Classes="glass" Width="40" Height="40" CornerRadius="20" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close preview">
          <c:Icon Data="{StaticResource Icon.Close}" Size="18" />
        </Button>
        <Border Grid.Column="2" Background="#8C0B0D16" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" IsVisible="{Binding PositionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="#D9F3F3FA" />
        </Border>
      </Grid>

      <!-- Previous / next -->
      <Button Classes="navigate" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding PreviousCommand}"
              IsVisible="{Binding HasPrevious}" ToolTip.Tip="Previous (←)" AutomationProperties.Name="Previous wallpaper">
        <c:Icon Data="{StaticResource Icon.ChevronLeft}" Size="22" />
      </Button>
      <Button Classes="navigate" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Command="{Binding NextCommand}"
              IsVisible="{Binding HasNext}" ToolTip.Tip="Next (→)" AutomationProperties.Name="Next wallpaper">
        <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="22" />
      </Button>

      <!-- Quality hint -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#8C0B0D16" CornerRadius="14" Padding="14,7"
              IsVisible="{Binding IsRefiningImage}">
        <TextBlock Text="Loading full quality…" FontSize="12" Foreground="#D9F3F3FA" />
      </Border>
    </Grid>

    <!-- ============ Details ============ -->
    <Border Grid.Column="1" Background="{DynamicResource LumaSidebarBrush}" BorderBrush="{DynamicResource LumaBorderSubtleBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,28,28,28" Spacing="22">

          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" LetterSpacing="-0.3" TextWrapping="Wrap" LineHeight="26" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCreator}">
              <TextBlock Text="by" Classes="secondary" VerticalAlignment="Center" />
              <Button Classes="link" Content="{Binding CreatorName}" Command="{Binding OpenCreatorCommand}" FontWeight="Medium" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="pill"><TextBlock Text="{Binding ProviderName}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource LumaTextSecondaryBrush}" /></Border>
              <Border Classes="pill"><TextBlock Text="{Binding ResolutionText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource LumaTextSecondaryBrush}" /></Border>
            </StackPanel>
          </StackPanel>

          <!-- Primary action -->
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanApply}">
              <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ApplyCommand}" IsEnabled="{Binding !IsApplying}" Height="46">
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                  <c:Icon Data="{StaticResource Icon.Monitor}" Size="18" />
                  <TextBlock Text="{Binding ApplyLabel}" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <ComboBox Grid.Column="1" ItemsSource="{Binding FitModes}" SelectedItem="{Binding SelectedFit}" Width="112" Height="46"
                        ToolTip.Tip="How the wallpaper fits the screen" AutomationProperties.Name="Fit mode" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ApplyProgress}" IsVisible="{Binding IsApplying}" />
            <TextBlock Text="{Binding ApplyNote}" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding !CanApply}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding DownloadCommand}" IsVisible="{Binding Item.CanDownload}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><c:Icon Data="{StaticResource Icon.Download}" Size="16" /><TextBlock Text="Download" /></StackPanel>
              </Button>
              <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding ShowInFolderCommand}" IsVisible="{Binding Item.IsDownloaded}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><c:Icon Data="{StaticResource Icon.FolderOpen}" Size="16" /><TextBlock Text="In library" /></StackPanel>
              </Button>
              <Button Classes="secondary" HorizontalAlignment="Stretch" IsEnabled="False" IsVisible="{Binding Item.IsDownloading}">
                <TextBlock Text="Downloading…" HorizontalAlignment="Center" />
              </Button>
              <Button Grid.Column="1" Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="Toggle favorite">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <c:Icon Data="{StaticResource Icon.Heart}" Size="16" IsFilled="{Binding Item.IsFavorite}" />
                  <TextBlock Text="{Binding Item.IsFavorite, Converter={x:Static v:FavoriteTextConverter.Instance}}" />
                </StackPanel>
              </Button>
            </Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Item.DownloadProgress}" IsVisible="{Binding Item.IsDownloading}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding AddToCollectionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><c:Icon Data="{StaticResource Icon.FolderPlus}" Size="16" /><TextBlock Text="Collection" /></StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding OpenSourceCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><c:Icon Data="{StaticResource Icon.ExternalLink}" Size="16" /><TextBlock Text="Source page" /></StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <Border Classes="divider" />

          <!-- Facts -->
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="11" ColumnSpacing="20">
            <TextBlock Grid.Row="0" Text="Resolution" Classes="key" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResolutionText}" Classes="value" />
            <TextBlock Grid.Row="1" Text="Aspect ratio" Classes="key" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AspectText}" Classes="value" />
            <TextBlock Grid.Row="2" Text="File size" Classes="key" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileSizeText}" Classes="value" />
            <TextBlock Grid.Row="3" Text="Format" Classes="key" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FileTypeText}" Classes="value" />
            <TextBlock Grid.Row="4" Text="Provider" Classes="key" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProviderName}" Classes="value" />
            <TextBlock Grid.Row="5" Text="Category" Classes="key" IsVisible="{Binding HasCategory}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CategoryText}" Classes="value" IsVisible="{Binding HasCategory}" />
          </Grid>

          <!-- Colours -->
          <StackPanel Spacing="10" IsVisible="{Binding HasColors}">
            <TextBlock Text="Palette" Classes="key" />
            <ItemsControl ItemsSource="{Binding Colors}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Converter={x:Static v:HexBrushConverter.Instance}}"
                          BorderBrush="#33FFFFFF" BorderThickness="1" ToolTip.Tip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Tags -->
          <StackPanel Spacing="10" IsVisible="{Binding HasTags}">
            <TextBlock Text="Tags" Classes="key" />
            <ItemsControl ItemsSource="{Binding Tags}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="pill" Margin="0,0,6,6"><TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource LumaTextSecondaryBrush}" /></Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- License / attribution -->
          <Border IsVisible="{Binding HasLicense}" Classes="card" Padding="16" CornerRadius="14">
            <StackPanel Spacing="9">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{StaticResource Icon.Scale}" Size="16" Foreground="{DynamicResource LumaTextSecondaryBrush}" />
                <TextBlock Text="{Binding LicenseName}" FontWeight="SemiBold" />
              </StackPanel>
              <SelectableTextBlock Text="{Binding Attribution}" Classes="meta" TextWrapping="Wrap" LineHeight="18" IsVisible="{Binding HasAttribution}" />
              <TextBlock Text="Credit the creator when you share or reuse this image." Classes="meta" TextWrapping="Wrap" />
              <Button Classes="link" Content="View license" Command="{Binding OpenLicenseCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
  </ThemeVariantScope>
</UserControl>
