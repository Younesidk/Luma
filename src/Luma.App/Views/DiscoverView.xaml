<UserControl
    x:Class="Luma.App.Views.DiscoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:vm="using:Luma.App.ViewModels"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: DiscoverViewModel (set by MainWindow.CreatePageView). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Heading ===== -->
    <StackPanel Grid.Row="0" Margin="32,4,32,0" Spacing="4">
      <TextBlock Text="Discover" Style="{StaticResource DisplayTextStyle}" />
      <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
    </StackPanel>

    <!-- ===== Search + filters ===== -->
    <Grid Grid.Row="1" Margin="32,22,32,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Height="44" CornerRadius="13" Background="{ThemeResource LumaSurfaceBrush}" BorderBrush="{ThemeResource LumaBorderSubtleBrush}" BorderThickness="1">
        <Grid Margin="14,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:LucideIcon Data="{StaticResource Icon.Search}" Size="18" Foreground="{ThemeResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="PageSearch" Grid.Column="1" Style="{StaticResource BareTextBoxStyle}" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="14"
                   Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search wallpapers, tags, places…" KeyDown="OnSearchKeyDown"
                   AutomationProperties.Name="Search wallpapers" />
          <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" CornerRadius="8"
                  Command="{x:Bind ViewModel.ClearSearchCommand, Mode=OneWay}"
                  Visibility="{x:Bind v:BindHelpers.VisibleIfNotEmpty(ViewModel.SearchText), Mode=OneWay, FallbackValue=Collapsed}"
                  ToolTipService.ToolTip="Clear search" AutomationProperties.Name="Clear search">
            <c:LucideIcon Data="{StaticResource Icon.Close}" Size="14" />
          </Button>
        </Grid>
      </Border>

      <!-- Segmented source selector (options built in code-behind from Sources) -->
      <Border Grid.Column="1" Background="{ThemeResource LumaSurfaceBrush}" BorderBrush="{ThemeResource LumaBorderSubtleBrush}" BorderThickness="1"
              CornerRadius="12" Padding="3" VerticalAlignment="Center">
        <StackPanel x:Name="SourceStrip" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="Source" />
      </Border>

      <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="44" Padding="16,0" CornerRadius="13" AutomationProperties.Name="Filters">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <c:LucideIcon Data="{StaticResource Icon.Sliders}" Size="17" VerticalAlignment="Center" />
          <TextBlock Text="Filters" VerticalAlignment="Center" />
          <Border Background="{ThemeResource LumaAccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="{x:Bind ViewModel.FilterBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource LumaOnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
        <Button.Flyout>
          <Flyout x:Name="FiltersFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
            <Flyout.FlyoutPresenterStyle>
              <Style TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="MaxHeight" Value="2000" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
              </Style>
            </Flyout.FlyoutPresenterStyle>
            <v:FilterPanel x:Name="Filters" />
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Width="44" Height="44" Padding="0" CornerRadius="13"
              Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
              ToolTipService.ToolTip="Refresh (Ctrl R)" AutomationProperties.Name="Refresh">
        <c:LucideIcon Data="{StaticResource Icon.Refresh}" Size="17" />
      </Button>
    </Grid>

    <!-- ===== Categories ===== -->
    <ScrollViewer Grid.Row="2" Margin="0,16,0,0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="CategoryList" Margin="32,0,32,4" IsTabStop="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryChip">
            <ToggleButton Style="{StaticResource ChipToggleButtonStyle}" Content="{x:Bind Label}" IsChecked="{x:Bind IsActive, Mode=OneWay}"
                          Click="OnCategoryClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ===== Gallery / states ===== -->
    <Grid Grid.Row="3" Margin="0,8,0,0">

      <c:WallpaperGrid x:Name="Gallery"
                       ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                       IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                       IsLoadingMore="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                       HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}"
                       LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand, Mode=OneWay}"
                       Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.IsError), Mode=OneWay, FallbackValue=Visible}">
        <c:WallpaperGrid.Header>
          <v:FeaturedHero x:Name="Hero" Margin="0,6,0,24" Visibility="{x:Bind ViewModel.HasFeatured, Mode=OneWay, FallbackValue=Collapsed}" />
        </c:WallpaperGrid.Header>
      </c:WallpaperGrid>

      <!-- Partial failure notice (above the gallery) -->
      <Border VerticalAlignment="Top" Margin="32,4,32,0" Padding="14,10" CornerRadius="12"
              Background="{ThemeResource LumaWarningSubtleBrush}" BorderBrush="{ThemeResource LumaWarningBrush}" BorderThickness="1"
              Visibility="{x:Bind ViewModel.HasPartialWarning, Mode=OneWay, FallbackValue=Collapsed}">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:LucideIcon Data="{StaticResource Icon.Alert}" Size="16" Foreground="{ThemeResource LumaWarningBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PartialWarning, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
          <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Retry" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" Padding="12,5" FontSize="12" />
        </Grid>
      </Border>

      <!-- Nothing matched -->
      <c:EmptyState Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.Search}" Heading="Nothing here yet"
                    Message="No wallpapers matched. Try a broader search, or loosen the filters.">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear filters" Command="{x:Bind ViewModel.ClearFiltersCommand, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay, FallbackValue=Collapsed}" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Content="Clear search" Command="{x:Bind ViewModel.ClearSearchCommand, Mode=OneWay}" />
        </StackPanel>
      </c:EmptyState>

      <!-- Failed -->
      <c:EmptyState Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, FallbackValue=Collapsed}" IsDanger="True" Icon="{StaticResource Icon.WifiOff}"
                    Heading="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorDetail, Mode=OneWay}">
        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LucideIcon Data="{StaticResource Icon.Refresh}" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="Try again" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </c:EmptyState>
    </Grid>
  </Grid>
</UserControl>
