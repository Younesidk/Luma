<UserControl
    x:Class="Luma.App.Views.LiveWallpapersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: LiveWallpapersViewModel (set by MainWindow.CreatePageView). Gallery cards: VideoCard. -->
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="32,4,32,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Live wallpapers" Style="{StaticResource DisplayTextStyle}" />
          <TextBlock Text="Videos that play behind your desktop icons while Luma is running." Style="{StaticResource SecondaryTextStyle}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Style="{StaticResource IconButtonStyle}" Height="42" Width="42" Command="{x:Bind ViewModel.OpenVideoFolderCommand, Mode=OneWay}"
                  ToolTipService.ToolTip="Open Luma's video folder" AutomationProperties.Name="Open video folder">
            <c:LucideIcon Data="{StaticResource Icon.FolderOpen}" Size="18" />
          </Button>
          <Button Style="{StaticResource SecondaryButtonStyle}" Height="42" Command="{x:Bind ViewModel.ImportCommand, Mode=OneWay}"
                  IsEnabled="{x:Bind ViewModel.IsSupported, Mode=OneWay, FallbackValue=False}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Data="{StaticResource Icon.Upload}" Size="16" VerticalAlignment="Center" />
              <TextBlock Text="Import videos" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="32,20,32,8" Spacing="10">
        <!-- Not available on this computer -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="16" CornerRadius="14"
                Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.IsSupported), Mode=OneWay, FallbackValue=Collapsed}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:LucideIcon Data="{StaticResource Icon.Info}" Size="20" Foreground="{ThemeResource LumaWarningBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UnsupportedReason, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
          </Grid>
        </Border>

        <!-- Import progress -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="14" CornerRadius="14" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay, FallbackValue=Collapsed}">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            <ProgressBar Style="{StaticResource LumaProgressBarStyle}" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ImportProgress, Mode=OneWay}" />
            <TextBlock Text="Luma copies the video into its own folder and checks that Windows can play it." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Now playing -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="12" CornerRadius="16" Visibility="{x:Bind ViewModel.HasActiveVideo, Mode=OneWay, FallbackValue=Collapsed}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="128" Height="72" CornerRadius="10" Background="{ThemeResource LumaSkeletonBrush}">
              <c:ThumbnailImage Source="{x:Bind ViewModel.ActiveThumbnail, Mode=OneWay}" DecodeWidth="320" CornerRadius="10" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource LumaAccentSecondaryBrush}" />
              <TextBlock Text="{x:Bind ViewModel.ActiveTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
              <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"
                         Foreground="{ThemeResource LumaWarningBrush}" Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.PauseCommand, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.CanPause, Mode=OneWay, FallbackValue=Collapsed}" AutomationProperties.Name="Pause live wallpaper">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LucideIcon Data="{StaticResource Icon.Pause}" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Pause" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.ResumeCommand, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.CanResume, Mode=OneWay, FallbackValue=Collapsed}" AutomationProperties.Name="Resume live wallpaper">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LucideIcon Data="{StaticResource Icon.Play}" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Resume" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay, FallbackValue=Collapsed}"
                      IsEnabled="{x:Bind v:BindHelpers.Not(ViewModel.IsApplying), Mode=OneWay, FallbackValue=True}" AutomationProperties.Name="Try again">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LucideIcon Data="{StaticResource Icon.Play}" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Try again" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="Turn the video off and keep its still frame as your wallpaper" AutomationProperties.Name="Turn off live wallpaper">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:LucideIcon Data="{StaticResource Icon.Stop}" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Turn off" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Gallery -->
      <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, FallbackValue=Collapsed}">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Margin="32,8,20,28">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="290" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="None" ItemsJustification="Start" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <v:VideoCard Width="290" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>

        <c:EmptyState Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.Film}" Heading="No live wallpapers yet"
                      Message="Import an MP4, MOV or WebM video from your computer. Luma keeps its own copy, plays it muted on a loop behind your icons, and pauses it when nobody can see it.">
          <Button Style="{StaticResource PrimaryButtonStyle}" Content="Import videos" Command="{x:Bind ViewModel.ImportCommand, Mode=OneWay}" />
        </c:EmptyState>
      </Grid>
    </Grid>

    <!-- ================= Preview (always dark) ================= -->
    <Grid x:Name="PreviewLayer" RequestedTheme="Dark" Background="#090B12" Visibility="{x:Bind ViewModel.IsPreviewOpen, Mode=OneWay, FallbackValue=Collapsed}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="24,18,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="ClosePreviewButton" Style="{StaticResource GlassButtonStyle}" Width="40" Height="40" CornerRadius="20"
                Command="{x:Bind ViewModel.ClosePreviewCommand, Mode=OneWay}" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close preview">
          <c:LucideIcon Data="{StaticResource Icon.Close}" Size="18" />
        </Button>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="PreviewTitle" FontSize="16" FontWeight="SemiBold" Foreground="#F3F3FA" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PreviewMeta" FontSize="12" Foreground="#A3A6B8" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="48,20,48,16" CornerRadius="12" Background="Black">
        <Grid>
          <c:VideoPreviewHost x:Name="PreviewHost"
                              Visibility="{x:Bind v:BindHelpers.VisibleIfEmpty(ViewModel.PreviewError), Mode=OneWay, FallbackValue=Visible}" />
          <c:EmptyState Visibility="{x:Bind v:BindHelpers.VisibleIfNotEmpty(ViewModel.PreviewError), Mode=OneWay, FallbackValue=Collapsed}" IsDanger="True"
                        Icon="{StaticResource Icon.Alert}" Heading="This video can't be played" Message="{x:Bind ViewModel.PreviewError, Mode=OneWay}" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="48,0,48,24" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="DisplayCombo" Width="220" Visibility="{x:Bind ViewModel.ShowDisplayChoice, Mode=OneWay, FallbackValue=Collapsed}"
                  AutomationProperties.Name="Show on display" ToolTipService.ToolTip="Which display shows the video" />
        <ComboBox x:Name="FitCombo" Grid.Column="1" Width="200" AutomationProperties.Name="Video fit" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#A3A6B8" TextWrapping="Wrap"
                   Text="Plays muted on a loop. Pauses automatically when the desktop is hidden." />
        <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Height="42" Command="{x:Bind ViewModel.ApplyPreviewCommand, Mode=OneWay}"
                IsEnabled="{x:Bind v:BindHelpers.Not(ViewModel.IsApplying), Mode=OneWay, FallbackValue=True}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LucideIcon Data="{StaticResource Icon.Monitor}" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="Set as wallpaper" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
