<UserControl
    x:Class="Luma.App.Views.FilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:vm="using:Luma.App.ViewModels"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: DiscoverViewModel (set by DiscoverView). Sections appear only for filters the selected source supports.
       Toggles and combo boxes are wired in code-behind (generic Option<T> records and bool? toggles). -->
  <Border Style="{StaticResource PopupBorderStyle}" Width="420" Padding="0">
    <ScrollViewer x:Name="Scroller" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel Margin="22" Spacing="18">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="NaN" Padding="10,6" Height="30"
                  Command="{x:Bind ViewModel.ClearFiltersCommand, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay, FallbackValue=Collapsed}"
                  AutomationProperties.Name="Clear all filters">
            <TextBlock Text="Clear all" FontSize="12" Foreground="{ThemeResource LumaAccentSecondaryBrush}" />
          </Button>
        </Grid>

        <TextBlock Text="{x:Bind ViewModel.FilterScopeNote, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" LineHeight="17"
                   Visibility="{x:Bind v:BindHelpers.VisibleIfNotEmpty(ViewModel.FilterScopeNote), Mode=OneWay, FallbackValue=Collapsed}" />

        <StackPanel Spacing="8">
          <TextBlock Text="Sort by" Style="{StaticResource LabelTextStyle}" />
          <ComboBox x:Name="SortCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort order" />
          <ComboBox x:Name="TopRangeCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Top list range"
                    Visibility="{x:Bind ViewModel.ShowTopRange, Mode=OneWay, FallbackValue=Collapsed}" />
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowCategories, Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="Category" Style="{StaticResource LabelTextStyle}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="GeneralToggle" Style="{StaticResource ChipToggleButtonStyle}" Content="General" />
            <ToggleButton x:Name="AnimeToggle" Style="{StaticResource ChipToggleButtonStyle}" Content="Anime" />
            <ToggleButton x:Name="PeopleToggle" Style="{StaticResource ChipToggleButtonStyle}" Content="People" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowPurity, Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="Content" Style="{StaticResource LabelTextStyle}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="SafeToggle" Style="{StaticResource ChipToggleButtonStyle}" Content="Safe" />
            <ToggleButton x:Name="SketchyToggle" Style="{StaticResource ChipToggleButtonStyle}" Content="Sketchy" />
            <ToggleButton x:Name="ExplicitToggle" Style="{StaticResource ChipToggleButtonStyle}" Content="Explicit"
                          Visibility="{x:Bind ViewModel.ShowExplicit, Mode=OneWay, FallbackValue=Collapsed}" />
          </StackPanel>
          <TextBlock Text="Explicit content needs a Wallhaven API key (Settings → Providers)." Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"
                     Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.ShowExplicit), Mode=OneWay, FallbackValue=Visible}" />
        </StackPanel>

        <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.ShowMinResolution, Mode=OneWay, FallbackValue=Collapsed}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="8">
            <TextBlock Text="Resolution" Style="{StaticResource LabelTextStyle}" />
            <ComboBox x:Name="ResolutionCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Minimum resolution" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" Visibility="{x:Bind ViewModel.ShowAspect, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="Shape" Style="{StaticResource LabelTextStyle}" />
            <ComboBox x:Name="AspectCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Aspect ratio" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowContentKind, Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="Type" Style="{StaticResource LabelTextStyle}" />
          <ComboBox x:Name="ContentKindCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Content type" />
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowLicense, Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="License" Style="{StaticResource LabelTextStyle}" />
          <ComboBox x:Name="LicenseCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="License" />
        </StackPanel>

        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowColors, Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="Colour" Style="{StaticResource LabelTextStyle}" />
          <!-- Wallhaven palette swatches -->
          <ItemsControl x:Name="ColorSwatches" IsTabStop="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColorChoice">
                <Button Width="30" Height="30" Padding="0" CornerRadius="15" Margin="0,0,8,8" BorderThickness="2" MinWidth="0" MinHeight="0"
                        Style="{StaticResource LumaButtonBaseStyle}"
                        Background="{x:Bind v:BindHelpers.HexBrush(Hex)}"
                        BorderBrush="{x:Bind v:BindHelpers.CheckBrush(IsSelected), Mode=OneWay}"
                        Click="OnColorClick"
                        ToolTipService.ToolTip="{x:Bind Hex}" AutomationProperties.Name="{x:Bind Hex}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
