<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             x:Class="Luma.App.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.Row="0" Margin="32,4,32,0" Spacing="4">
      <TextBlock Text="Favorites" Classes="display" />
      <TextBlock Text="{Binding CountText}" Classes="secondary" FontSize="14" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="32,22,32,16" ColumnDefinitions="*,200,190" ColumnSpacing="10">
      <Border Height="44" CornerRadius="13" Background="{DynamicResource LumaSurfaceBrush}" BorderBrush="{DynamicResource LumaBorderSubtleBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*" Margin="14,0,12,0">
          <c:Icon Data="{StaticResource Icon.Search}" Size="18" Foreground="{DynamicResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="PageSearch" Grid.Column="1" Classes="bare" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                   Text="{Binding SearchText}" PlaceholderText="Search your favorites" AutomationProperties.Name="Search favorites" />
        </Grid>
      </Border>
      <ComboBox Grid.Column="1" Height="44" HorizontalAlignment="Stretch" ItemsSource="{Binding ProviderChoices}" SelectedItem="{Binding SelectedProvider}" AutomationProperties.Name="Filter by source" />
      <ComboBox Grid.Column="2" Height="44" HorizontalAlignment="Stretch" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="Sort favorites" />
    </Grid>

    <Grid Grid.Row="2">
      <c:WallpaperGrid ItemsSource="{Binding Items}" IsLoading="{Binding IsLoading}" IsVisible="{Binding !IsEmpty}" />

      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Heart}"
                    Heading="No favorites yet" Message="Tap the heart on any wallpaper to keep it here. Favorites are saved on this computer, so they stay available even when a source is offline.">
        <Button Classes="primary" Content="Discover wallpapers" Command="{Binding BrowseDiscoverCommand}" />
      </c:EmptyState>
    </Grid>
  </Grid>
</UserControl>

