<UserControl
    x:Class="Luma.App.Views.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: DownloadsViewModel (set by MainWindow.CreatePageView). Rows: DownloadJobRow and LibraryRow. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Heading -->
    <Grid Grid.Row="0" Margin="32,4,32,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="Downloads" Style="{StaticResource DisplayTextStyle}" />
        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="14"
                   Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, FallbackValue=Collapsed}" />
        <TextBlock Text="Wallpapers you download live here and stay available offline." Style="{StaticResource SecondaryTextStyle}" FontSize="14"
                   Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.HasItems), Mode=OneWay, FallbackValue=Visible}" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Height="42" Command="{x:Bind ViewModel.ImportCommand, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:LucideIcon Data="{StaticResource Icon.Upload}" Size="16" VerticalAlignment="Center" />
          <TextBlock Text="Import images" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Search + sort -->
    <Grid Grid.Row="1" Margin="32,22,32,12" ColumnSpacing="10" Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.IsEmpty), Mode=OneWay, FallbackValue=Visible}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="190" />
      </Grid.ColumnDefinitions>
      <Border Height="44" CornerRadius="13" Background="{ThemeResource LumaSurfaceBrush}" BorderBrush="{ThemeResource LumaBorderSubtleBrush}" BorderThickness="1">
        <Grid Margin="14,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <c:LucideIcon Data="{StaticResource Icon.Search}" Size="18" Foreground="{ThemeResource LumaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="PageSearch" Grid.Column="1" Style="{StaticResource BareTextBoxStyle}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                   Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search downloads" AutomationProperties.Name="Search downloads" />
        </Grid>
      </Border>
      <ComboBox x:Name="SortCombo" Grid.Column="1" Height="44" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort downloads" />
    </Grid>

    <!-- Active transfers -->
    <StackPanel Grid.Row="2" Margin="32,4,32,12" Spacing="10" Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay, FallbackValue=Collapsed}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Transfers" Style="{StaticResource SectionTextStyle}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="NaN" Padding="10,6" Height="30"
                Command="{x:Bind ViewModel.ClearFinishedCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFinishedJobs, Mode=OneWay, FallbackValue=Collapsed}">
          <TextBlock Text="Clear finished" FontSize="12" Foreground="{ThemeResource LumaAccentSecondaryBrush}" />
        </Button>
      </Grid>
      <!-- Capped so a long queue never pushes the library off screen. -->
      <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="8" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <v:DownloadJobRow />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
    </StackPanel>

    <!-- Library (virtualized) -->
    <Grid Grid.Row="3">
      <ScrollViewer Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, FallbackValue=Collapsed}" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Margin="32,4,32,28">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="10" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <v:LibraryRow />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <c:EmptyState Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.Download}" Heading="Nothing downloaded yet"
                    Message="Download a wallpaper to keep a full-resolution copy on this computer. You can also import images you already have.">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Style="{StaticResource SecondaryButtonStyle}" Content="Import images" Command="{x:Bind ViewModel.ImportCommand, Mode=OneWay}" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Content="Discover wallpapers" Command="{x:Bind ViewModel.BrowseDiscoverCommand, Mode=OneWay}" />
        </StackPanel>
      </c:EmptyState>
      <c:EmptyState Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.Search}" Heading="No matches"
                    Message="None of your downloads match that search." />
    </Grid>
  </Grid>
</UserControl>
