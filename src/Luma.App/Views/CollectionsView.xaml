<UserControl
    x:Class="Luma.App.Views.CollectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: CollectionsViewModel (set by MainWindow.CreatePageView). Overview cards: CollectionCard. -->
  <Grid>
    <!-- ================= Overview ================= -->
    <Grid Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay, FallbackValue=Visible}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="32,4,32,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Collections" Style="{StaticResource DisplayTextStyle}" />
          <TextBlock Text="Group wallpapers any way you like. Deleting a collection never deletes the wallpapers." Style="{StaticResource SecondaryTextStyle}"
                     FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.CreateCommand, Mode=OneWay}" VerticalAlignment="Bottom" Height="42">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LucideIcon Data="{StaticResource Icon.Plus}" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="New collection" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                    Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.IsOverviewEmpty), Mode=OneWay, FallbackValue=Visible}">
        <ItemsRepeater x:Name="CollectionsRepeater" ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}" Margin="32,0,32,32"
                       ElementPrepared="OnCollectionPrepared" ElementClearing="OnCollectionClearing">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="290" MinColumnSpacing="20" MinRowSpacing="24" ItemsStretch="None" ItemsJustification="Start" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <v:CollectionCard Width="290" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <c:EmptyState Grid.Row="1" Visibility="{x:Bind ViewModel.IsOverviewEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.Layers}"
                    Heading="Create your first collection"
                    Message="Collections are perfect for moods, projects or a desk setup: Dark wallpapers, Nature, Anime, Favorites for later.">
        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.CreateCommand, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LucideIcon Data="{StaticResource Icon.Plus}" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="New collection" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </c:EmptyState>
    </Grid>

    <!-- ================= Detail ================= -->
    <Grid Visibility="{x:Bind ViewModel.IsDetail, Mode=OneWay, FallbackValue=Collapsed}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="32,4,32,20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Style="{StaticResource SecondaryButtonStyle}" Width="44" Height="44" Padding="0" CornerRadius="13"
                Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"
                ToolTipService.ToolTip="All collections" AutomationProperties.Name="Back to collections">
          <c:LucideIcon Data="{StaticResource Icon.ArrowLeft}" Size="18" />
        </Button>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock x:Name="DetailName" Style="{StaticResource DisplayTextStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DetailDescription" Style="{StaticResource SecondaryTextStyle}" FontSize="14" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailCount" Style="{StaticResource MetaTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RenameCommand, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Data="{StaticResource Icon.Pencil}" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Edit" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource DangerGhostButtonStyle}" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Data="{StaticResource Icon.Trash}" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Delete" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <c:WallpaperGrid x:Name="DetailGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                       Visibility="{x:Bind v:BindHelpers.Collapsed(ViewModel.DetailIsEmpty), Mode=OneWay, FallbackValue=Visible}" />
      <c:EmptyState Grid.Row="1" Visibility="{x:Bind ViewModel.DetailIsEmpty, Mode=OneWay, FallbackValue=Collapsed}" Icon="{StaticResource Icon.FolderPlus}"
                    Heading="This collection is empty" Message="Open any wallpaper and choose Collection to add it here." />
    </Grid>
  </Grid>
</UserControl>
