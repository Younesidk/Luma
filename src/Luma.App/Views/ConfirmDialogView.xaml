<UserControl
    x:Class="Luma.App.Views.ConfirmDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Luma.App.Controls"
    IsTabStop="False">

  <!-- ViewModel: ConfirmDialogViewModel. Destructive confirmations focus Cancel; others focus the confirm button. -->
  <Border Style="{StaticResource PopupBorderStyle}" Width="440" Padding="28" CornerRadius="20" Background="{ThemeResource LumaDialogBrush}"
          Translation="0,0,40">
    <Border.Shadow>
      <ThemeShadow />
    </Border.Shadow>
    <StackPanel Spacing="22">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="12" Background="{ThemeResource LumaErrorSubtleBrush}" Visibility="{x:Bind ViewModel.IsDestructive}">
            <c:LucideIcon Data="{StaticResource Icon.Alert}" Size="18" Foreground="{ThemeResource LumaErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{x:Bind ViewModel.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Message}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" LineHeight="21" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CancelDialogCommand}" />
        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" Content="{x:Bind ViewModel.ConfirmText}" Command="{x:Bind ViewModel.ConfirmCommand}"
                Visibility="{x:Bind ViewModel.IsNotDestructive}" />
        <Button Style="{StaticResource DangerButtonStyle}" Content="{x:Bind ViewModel.ConfirmText}" Command="{x:Bind ViewModel.ConfirmCommand}"
                Visibility="{x:Bind ViewModel.IsDestructive}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
