<UserControl
    x:Class="Luma.App.Views.FeedbackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:Luma.App.Views"
    IsTabStop="False">

  <!-- ViewModel: FeedbackViewModel (set by MainWindow.CreatePageView). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <StackPanel Margin="32,4,32,48" Spacing="28" MaxWidth="720" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="Feedback" Style="{StaticResource DisplayTextStyle}" />
        <TextBlock Text="Found a bug or have an idea? Tell me about it." Style="{StaticResource SecondaryTextStyle}" FontSize="14" TextWrapping="Wrap" />
      </StackPanel>

      <Border Style="{StaticResource CardBorderStyle}" Padding="24">
        <StackPanel Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Text="Type" Style="{StaticResource MetaTextStyle}" />
            <ComboBox x:Name="TypeCombo" Width="220" AutomationProperties.Name="Feedback type" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Title" Style="{StaticResource MetaTextStyle}" />
            <TextBox Text="{x:Bind ViewModel.FeedbackTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="{x:Bind ViewModel.MaxTitleLength, Mode=OneWay}" PlaceholderText="A short summary"
                     AutomationProperties.Name="Feedback title" />
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Description" Style="{StaticResource MetaTextStyle}" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DescriptionCounter, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
            </Grid>
            <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="360"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MaxLength="{x:Bind ViewModel.MaxDescriptionLength, Mode=OneWay}"
                     PlaceholderText="What happened, or what would you like to see? For bugs, the steps to reproduce help a lot."
                     AutomationProperties.Name="Feedback description" />
          </StackPanel>

          <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource LumaErrorBrush}" TextWrapping="Wrap"
                     Visibility="{x:Bind v:BindHelpers.VisibleIfNotEmpty(ViewModel.Error), Mode=OneWay, FallbackValue=Collapsed}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Your app version and operating system are included. Nothing else is sent."
                       Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="{x:Bind ViewModel.SubmitText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SubmitCommand, Mode=OneWay}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
