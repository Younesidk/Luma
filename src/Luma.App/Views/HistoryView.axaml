<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Luma.App.Controls"
             xmlns:vm="using:Luma.App.ViewModels"
             x:Class="Luma.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" Margin="32,4,32,18" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="History" Classes="display" />
        <TextBlock Text="Every wallpaper you've applied, newest first." Classes="secondary" FontSize="14" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary danger-ghost" VerticalAlignment="Bottom" Height="42" Command="{Binding ClearCommand}" IsVisible="{Binding HasEntries}">
        <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Trash}" Size="15" /><TextBlock Text="Clear history" /></StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <ListBox Classes="plain" ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}" Padding="32,0,32,28">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryEntryViewModel">
            <Border Classes="card" Padding="12" CornerRadius="16" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Button Padding="0" CornerRadius="10" Command="{Binding PreviewCommand}" ClipToBounds="True" AutomationProperties.Name="Preview">
                  <Border Width="136" Height="80" Background="{DynamicResource LumaSkeletonBrush}">
                    <c:ThumbnailImage Source="{Binding ThumbnailSource}" DecodeWidth="320" />
                  </Border>
                </Button>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AppliedText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource LumaAccentSecondaryBrush}" />
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DetailText}" Classes="meta" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="secondary" Command="{Binding ReapplyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{StaticResource Icon.Refresh}" Size="15" /><TextBlock Text="Apply again" /></StackPanel>
                  </Button>
                  <Button Classes="icon" Command="{Binding ShowInFolderCommand}" IsEnabled="{Binding HasFile}" ToolTip.Tip="Show in folder" AutomationProperties.Name="Show in folder">
                    <c:Icon Data="{StaticResource Icon.FolderOpen}" Size="18" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.History}" Heading="No history yet"
                    Message="When you set a wallpaper, it shows up here so you can bring any of them back with one click.">
        <Button Classes="primary" Content="Discover wallpapers" Command="{Binding BrowseDiscoverCommand}" />
      </c:EmptyState>
    </Grid>
  </Grid>
</UserControl>
