<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luma.App.ViewModels"
             x:Class="Luma.App.Views.FeedbackView"
             x:DataType="vm:FeedbackViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,4,32,48" Spacing="28" MaxWidth="720" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="Feedback" Classes="display" />
        <TextBlock Text="Found a bug or have an idea? Tell me about it." Classes="secondary" FontSize="14" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card" Padding="24">
        <StackPanel Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Text="Type" Classes="meta" />
            <ComboBox Width="220" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" AutomationProperties.Name="Feedback type" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Title" Classes="meta" />
            <TextBox Text="{Binding FeedbackTitle}" MaxLength="{Binding MaxTitleLength}" PlaceholderText="A short summary"
                     AutomationProperties.Name="Feedback title" />
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Description" Classes="meta" />
              <TextBlock Grid.Column="1" Text="{Binding DescriptionCounter}" Classes="meta" />
            </Grid>
            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="360"
                     MaxLength="{Binding MaxDescriptionLength}"
                     PlaceholderText="What happened, or what would you like to see? For bugs, the steps to reproduce help a lot."
                     AutomationProperties.Name="Feedback description" />
          </StackPanel>

          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource LumaErrorBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Your app version and operating system are included. Nothing else is sent."
                       Classes="meta" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1" Classes="primary" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
