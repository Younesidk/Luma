      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#667088" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#191E2B" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#202638" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#202638" />
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#191E2B" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#303547" />
