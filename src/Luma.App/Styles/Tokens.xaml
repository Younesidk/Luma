      <SolidColorBrush x:Key="LumaErrorSubtleBrush" Color="#24F07885" />
      <SolidColorBrush x:Key="LumaHoverBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="LumaPressedBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="LumaSkeletonBrush" Color="#1E2434" />
      <SolidColorBrush x:Key="LumaScrimBrush" Color="#0A0C14" Opacity="0.72" />
      <SolidColorBrush x:Key="LumaDialogBrush" Color="#1A1F2E" />

      <!-- Fluent (WinUI) control resource overrides so stock controls match Luma -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#191E2B" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#191E2B" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#191E2B" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#303547" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#454B62" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8B7CFF" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#F3F3FA" />
