      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#AEB4C6" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F1120" />
      <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#202638" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#303547" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#202638" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#303547" />
      <SolidColorBrush x:Key="ToolTipBackground" Color="#202638" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#303547" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#F3F3FA" />
      <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FFFFFF" Opacity="0.20" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FFFFFF" Opacity="0.34" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FFFFFF" Opacity="0.46" />
