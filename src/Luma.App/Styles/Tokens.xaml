      <SolidColorBrush x:Key="LumaAccentSecondaryBrush" Color="#A99BFF" />
      <SolidColorBrush x:Key="LumaAccentSubtleBrush" Color="#298B7CFF" />
      <SolidColorBrush x:Key="LumaOnAccentBrush" Color="#0F1120" />
      <SolidColorBrush x:Key="LumaTextPrimaryBrush" Color="#F3F3FA" />
      <SolidColorBrush x:Key="LumaTextSecondaryBrush" Color="#9299AC" />
      <SolidColorBrush x:Key="LumaTextTertiaryBrush" Color="#667088" />
      <SolidColorBrush x:Key="LumaBorderBrush" Color="#303547" />
      <SolidColorBrush x:Key="LumaBorderSubtleBrush" Color="#232839" />
      <SolidColorBrush x:Key="LumaSuccessBrush" Color="#65C99A" />
      <SolidColorBrush x:Key="LumaWarningBrush" Color="#E8B96C" />
      <SolidColorBrush x:Key="LumaErrorBrush" Color="#F07885" />
      <SolidColorBrush x:Key="LumaSuccessSubtleBrush" Color="#2465C99A" />
